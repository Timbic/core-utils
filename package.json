{
	"name": "@timbic/core-utils",
	"type": "module",
	"version": "0.0.1",
	"private": false,
	"description": "Timbic's set of tools used in almost every project",
	"author": "Timur Bikmuhametov <tim.bic22@gmail.com>",
	"license": "MIT",
	"keywords": [
		"prettier",
		"eslint",
		"stylelint",
		"git",
		"husky",
		"lint-staged",
		"scaffolder"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Timbic/core-utils.git"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"bin": {
		"core-utils": "index.js"
	},
	"files": [
		"dist",
		"index.js"
	],
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"execute": "node index.js",
		"fmt": "prettier --cache --write .",
		"fmt:chk": "prettier --check .",
		"lint": "eslint --cache",
		"lint:fix": "eslint --cache --fix",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"prepare": "husky"
	},
	"dependencies": {
		"@timbic/eslint-config": "^1.2.5",
		"@timbic/prettier-config": "^2.0.4",
		"@timbic/stylelint-config": "1.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1"
	},
	"devDependencies": {
		"@clack/prompts": "1.9.0",
		"@types/node": "26.6.6",
		"bumpp": "12.3.0",
		"mri": "1.2.0",
		"tsdown": "0.23.7",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*.{js,ts,md,json,yaml,yml}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"packageManager": "pnpm@12.21.0"
}
